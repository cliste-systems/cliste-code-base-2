# LiveKit voice worker (Cara-only) — see docs in code-base-1 VOICE-WORKER-CONTRACT.md

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Worker name for explicit dispatch (default cliste-voice-node).
LIVEKIT_AGENT_NAME=cliste-voice-node

# Dev dispatch fallbacks (production resolves org by dialed phone_numbers.e164)
# DEFAULT_ORG_PHONE=+353749389378
# CARA_TEST_CALLED_NUMBERS=+353749389378 — public Hello Cara demo only (not +353109307440 SuperValu QA)
# CARA_FACTORY_FRESH_CALLED_NUMBERS=+353749759508 — spare Irish line, vanilla Cartesia Siobhan (no demo stack)
# DEFAULT_ORG_SLUG=my-business
# CARA_OFFLINE_PLAYGROUND=true — skip Supabase org lookup for LiveKit Console/Playground (local only)

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# ORG_TIMEZONE=Europe/Dublin

# STT / LLM — recommended Hello Cara demo stack (also set on call_test_profiles in Supabase)
# LIVEKIT_INFERENCE_STT_MODEL=assemblyai/u3-rt-pro
# CARA_LLM_PROVIDER=openrouter
# OPENROUTER_MODEL=openai/gpt-5-mini
# Fallback STT: assemblyai/universal-streaming (uses keyterms_prompt instead of domain prompt)
# LIVEKIT_INFERENCE_STT_LANGUAGE=en
# Salon STT tuning (AssemblyAI — used with u3-rt-pro and universal-streaming)
# LIVEKIT_STT_LATENCY_PROFILE=snappy
# snappy (default): faster replies — 200/1000ms silence, EOT 0.35, no stacked endpointing on u3
# balanced: prior accuracy-first tuning — 300/1400ms, EOT 0.4, +80/900ms endpointing on u3
# LIVEKIT_STT_MIN_TURN_SILENCE_MS=200
# LIVEKIT_STT_MAX_TURN_SILENCE_MS=1000
# LIVEKIT_STT_EOT_CONFIDENCE=0.35
# LIVEKIT_STT_DOMAIN_PROMPT=  (optional override; default built from org name)
# LIVEKIT_STT_EXTRA_KEYTERMS=Grafton,Dublin
# LLM runs via OpenRouter by default when OPENROUTER_API_KEY is set (recommended).
# CARA_LLM_PROVIDER=openrouter | gateway | openai-direct
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5-mini
# CARA_OPENROUTER_MODEL=openai/gpt-5-mini
# OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_APP_TITLE=Cliste Cara Voice
# OPENROUTER_HTTP_REFERER=https://hellocara.ie
# LIVEKIT_INFERENCE_LLM_MODEL=openai/gpt-4.1
# Recommended for voice latency; gpt-5-mini needs headroom for reasoning tokens.
# LIVEKIT_LLM_TEMPERATURE=0.7
# LIVEKIT_LLM_MAX_TOKENS=320
# Optional repetition penalties — default 0 (nonzero can suppress required menu/route names).
# LIVEKIT_LLM_FREQUENCY_PENALTY=0
# LIVEKIT_LLM_PRESENCE_PENALTY=0
# Per-call conversational variety (manner, greeting, acks, sign-off). Off pins old fixed wording.
# CARA_PERSONA_VARIETY=on
# Demo/test line — balanced STT + longer endpointing (defaults in code if unset):
# LIVEKIT_TEST_STT_LATENCY_PROFILE=balanced
# LIVEKIT_TEST_STT_MIN_TURN_SILENCE_MS=400
# LIVEKIT_TEST_STT_MAX_TURN_SILENCE_MS=1400
# LIVEKIT_TEST_ENDPOINTING_MAX_MS=1200
# LIVEKIT_TEST_PREEMPTIVE_GENERATION=1
# Fallback: LiveKit inference gateway (CARA_LLM_PROVIDER=gateway, no API key).
# openai-direct only if you have OpenAI credits: CARA_LLM_PROVIDER=openai-direct + OPENAI_API_KEY

# ElevenLabs TTS (production fallback when CARA_TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
# Trial default: Cartesia Siobhan via LiveKit Inference (no Eleven key required).
# CARA_TTS_PROVIDER=cartesia-inference
# LIVEKIT_INFERENCE_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_INFERENCE_TTS_VOICE=d79d2b77-9192-4e10-9407-5d43ca034803
# LIVEKIT_INFERENCE_TTS_LANGUAGE=en
# Plain Siobhan only — do NOT set EMOTION / SPEED / VOLUME overrides (they kill the Irish accent).
# ELEVEN_VOICE_ID=odyUrTN5HMVKujvVAgWW
# ELEVEN_TTS_MODEL=eleven_v3
# eleven_v3 is the default — warm expressive Irish delivery on the demo line.
# Turbo remains available for latency experiments: eleven_turbo_v2_5
# ELEVEN_TTS_ENCODING=pcm_24000
# ELEVEN_STREAMING_LATENCY=0
# ELEVEN_TTS_AUTO_MODE=false
# A/B starting points for phone: stability 0.55, style 0.18–0.22 (lower style = less roomy/shouty on turbo)
# ELEVEN_VOICE_SPEED=0.93
# ELEVEN_VOICE_STABILITY=0.55
# ELEVEN_VOICE_SIMILARITY=0.78
# ELEVEN_VOICE_STYLE=0.20
# ELEVEN_STREAMING_LATENCY=0
# Greeting follows ELEVEN_TTS_MODEL by default (v3).
# GREETING_TTS_MODEL=eleven_v3
# ELEVEN_TTS_MODEL=eleven_v3
# ELEVEN_VOICE_SPEAKER_BOOST=false
# ELEVEN_PRONUNCIATION_DICTIONARY_ID=
# ELEVEN_PRONUNCIATION_DICTIONARY_VERSION_ID=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
# GREETING_AUDIO_CACHE_DIR=/tmp/greeting-cache
# Mirror each call transcript to call-transcripts/latest.md (local dev; use watch:call-transcripts or export:latest-call for prod)
# CARA_TRANSCRIPT_MIRROR_DIR=call-transcripts
# CARA_TRANSCRIPT_OPEN=0
# CARA_TRANSCRIPT_POLL_MS=3000
# CARA_TRANSCRIPT_WAIT_MS=120000
# CARA_TRANSCRIPT_WAIT=1
# CARA_TRANSCRIPT_ORG_NAME=Bloom Beauty Studio

# Voice worker → dashboard webhooks (same secret in code-base-1 Vercel env)
# CLISTE_APP_URL=https://app.hellocara.ie
CLISTE_APP_URL=
CLISTE_VOICE_WEBHOOK_SECRET=

# Direct Twilio SMS (primary path for booking links)
# CARA_SMS_DRY_RUN=true — log [sms] dry_run and return success without Twilio (phone test flow)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Platform sender for owner alerts only — NOT used for caller booking links
# TWILIO_SMS_FROM=+447...
# Irish org DID (+353…) SMS requires Twilio IE1 regional credentials (Console → Ireland region → API keys)
# TWILIO_IE1_AUTH_TOKEN=
# Or: TWILIO_IE1_API_KEY= + TWILIO_IE1_API_SECRET=
# Voice-only +353 DIDs cannot send SMS — use IE1 alphanumeric or messaging service instead:
# TWILIO_IE1_ALPHA_SENDER=BloomBeauty
# TWILIO_IE1_MESSAGING_SERVICE_SID=MG...
# CLISTE_VOICE_HTTP_TIMEOUT_MS=6000
# CLISTE_VOICE_CALL_COMPLETE_TIMEOUT_MS=15000
# CLISTE_CALL_POSTPROCESS_TIMEOUT_MS=12000
# LIVEKIT_TRANSCRIPT_FLUSH_MS=300
# LIVEKIT_DISCONNECT_PLAYOUT_MS=2400
# LIVEKIT_END_CALL_POST_SPEECH_MS=120
# LIVEKIT_POST_GREETING_GRACE_MS=5000
# LIVEKIT_TEST_POST_GREETING_GRACE_MS=2500
# LIVEKIT_TEST_PREEMPTIVE_GENERATION=1
# LIVEKIT_PREEMPTIVE_GENERATION=0

# Optional stall phrase during slow tool/SMS work — test line defaults to 1000ms when unset.
# LIVEKIT_RESPONSE_FILLER_MS=1200
# LIVEKIT_RESPONSE_FILLER_MAX_PER_CALL=3
# LIVEKIT_DEAD_AIR_MS=7000
# LIVEKIT_DEAD_AIR_CLOSE_MS=8000
# LIVEKIT_DEAD_AIR_MAX_PROMPTS=2

# Endpointing / turn detection (u3-rt-pro: snappy profile uses 0/0 — STT neural turn only)
# LIVEKIT_ENDPOINTING_MIN_MS=0
# LIVEKIT_ENDPOINTING_MAX_MS=0
# LIVEKIT_USE_TURN_DETECTOR=on
# LIVEKIT_LLM_TEMPERATURE=0.55
# LIVEKIT_LLM_MAX_TOKENS=120

# Org config cache (ms). Default 30s.
# CLISTE_ORG_CACHE_TTL_MS=30000

# GDPR transcript retention for scripts/gdpr-purge-transcripts.ts
# CLISTE_TRANSCRIPT_RETENTION_DAYS=30

# Ring-time smoke: RING_SMOKE_PHONE=+353... npm run test:ring-smoke

# --- Estimated call cost (USD) for admin / call_logs.cost_estimate ---
# CALL_COST_LIVEKIT_USD_PER_MIN=0.01
# CALL_COST_STT_USD_PER_MIN=0.006
# CALL_COST_TTS_USD_PER_MIN=0.13
# CALL_COST_TWILIO_SMS_USD_EACH=0.008
