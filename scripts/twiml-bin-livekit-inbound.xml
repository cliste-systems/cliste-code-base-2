<?xml version="1.0" encoding="UTF-8"?>
<!--
  Paste into Twilio: Console → TwiML Bins → Create new TwiML Bin.

  Production uses Twilio Elastic SIP Trunk origination instead (see livekit-cloud-deploy.md).
  This template is for manual per-number TwiML setup if needed.

  SIP host: LiveKit Cloud → Project settings → SIP (NOT the wss hostname).
  HelloCara EU: 4isoiid8ii2.eu.sip.livekit.cloud

  Docs: https://docs.livekit.io/telephony/accepting-calls/inbound-twilio/
-->
<Response>
  <Dial timeout="60" answerOnBridge="true">
    <Sip>sip:{{To}}@4isoiid8ii2.eu.sip.livekit.cloud;transport=tcp</Sip>
  </Dial>
</Response>
