# Copy to secrets.production.env (gitignored) and fill from production env / Vercel.
# Used with: lk agent create|deploy|update-secrets --secrets-file secrets.production.env
#
# Do NOT set these — LiveKit Cloud injects them at runtime:
# LIVEKIT_URL
# LIVEKIT_API_KEY
# LIVEKIT_API_SECRET

LIVEKIT_AGENT_NAME=cliste-retail-node

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

CLISTE_APP_URL=https://app.hellocara.ie
CLISTE_VOICE_WEBHOOK_SECRET=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_IE1_ALPHA_SENDER=
TWILIO_IE1_API_KEY=
TWILIO_IE1_API_SECRET=
TWILIO_IE1_MESSAGING_SERVICE_SID=

CALL_RECORDING_EGRESS_S3_ACCESS_KEY=
CALL_RECORDING_EGRESS_S3_SECRET_KEY=
CALL_RECORDING_EGRESS_S3_BUCKET=
CALL_RECORDING_EGRESS_S3_ENDPOINT=
CALL_RECORDING_EGRESS_S3_REGION=auto

CARA_LLM_PROVIDER=gateway
LIVEKIT_INFERENCE_STT_MODEL=assemblyai/universal-3-5-pro
LIVEKIT_INFERENCE_LLM_MODEL=google/gemma-4-31b-it
LIVEKIT_INFERENCE_TTS_MODEL=cartesia/sonic-3.6
LIVEKIT_INFERENCE_TTS_VOICE=
LIVEKIT_STT_LATENCY_PROFILE=snappy
LIVEKIT_STT_WARMUP=1

# Optional — copy from production if set
# STRIPE_SECRET_KEY=
# OPENROUTER_API_KEY=
